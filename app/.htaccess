# Aplicatia "Lista de cumparaturi" - fisiere statice

Options -Indexes

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    # camera e necesara pentru scanarea cardurilor de fidelitate (doar pe domeniul propriu)
    Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(self), screen-wake-lock=(self)"

    # index.html si service worker-ul se verifica de fiecare data,
    # altfel utilizatorii raman blocati pe o versiune veche
    <FilesMatch "^(index\.html|sw\.js|manifest\.webmanifest)$">
        Header set Cache-Control "no-cache, must-revalidate"
    </FilesMatch>

    # JS si CSS: se verifica la fiecare incarcare (raspuns 304 daca nu s-au schimbat).
    # Functionarea offline o asigura service worker-ul, nu cache-ul browserului.
    <FilesMatch "\.(js|css)$">
        Header set Cache-Control "no-cache"
        Header unset Expires
    </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/png "access plus 30 days"
    ExpiresByType image/svg+xml "access plus 30 days"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

AddType application/manifest+json .webmanifest
